# Copy to .env.local and fill in. Never commit .env.local.

# GitHub: push branches and open PRs on forks you own.
# Falls back to `gh auth token` if unset.
GITHUB_TOKEN=

# Fix agent (first available wins unless FOREWARNED_AGENT is set):
# - claude CLI, or
# - codex CLI, or
# - Anthropic API (llm fallback)
ANTHROPIC_API_KEY=

# Force the agent: claude | codex | llm
# FOREWARNED_AGENT=claude

# Optional: run install/tsc/tests in Freestyle VMs instead of locally
# FOREWARNED_SANDBOX=freestyle
# FREESTYLE_API_KEY=

# Comma-separated owners allowed for push when the repo is not a fork
# FOREWARNED_ALLOWED_OWNERS=

# Extra repos for scripts/reset.ts
# FOREWARNED_DEMO_REPOS=https://github.com/A5bhinav/openai-api-example
